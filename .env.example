# Lokale dev (poort 3456)
PORT=3456

# Vimeo hero/film (optioneel lokaal)
NEXT_PUBLIC_VIMEO_HERO_ID=
NEXT_PUBLIC_VIMEO_FILM_ID=

# SEO / indexering
# staging = noindex + robots disallow (standaard als niet gezet)
# production = index + sitemap (alleen op live domein)
NEXT_PUBLIC_SITE_ENV=staging
NEXT_PUBLIC_SITE_URL=https://stark.roholt.nl

# Netlify Production context bij livegang:
# NEXT_PUBLIC_SITE_ENV=production
# NEXT_PUBLIC_SITE_URL=https://[definitief-domein]
