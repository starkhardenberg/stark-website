# Lokale dev (poort 3456)
PORT=3456

# Hero: lokale HQ in public/videos/ (defaults in lib/hero-video.ts)
# NEXT_PUBLIC_HERO_VIDEO_DESKTOP_URL=/videos/hero-desktop.mp4
# NEXT_PUBLIC_HERO_VIDEO_MOBILE_URL=/videos/hero-mobile.mp4
# NEXT_PUBLIC_HERO_VIDEO_POSTER=/videos/hero-poster.jpg

# Film-sectie (Vimeo, klik-om-af-te-spelen)
NEXT_PUBLIC_VIMEO_FILM_ID=

# SEO / indexering
# Canonical is altijd https://www.starkhardenberg.nl
# Indexeren hangt alleen aan Netlify CONTEXT:
# production → index, follow. Alles anders (preview, branch, lokaal) → noindex, nofollow.
NEXT_PUBLIC_SITE_ENV=staging
